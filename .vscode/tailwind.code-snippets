{
  "Tailwind Variants Recipe": {
    "prefix": "gstv",
    "body": [
      "import { tv, type VariantProps } from 'tailwind-variants';",
      "",
      "export const ${1:component}Variants = tv({",
      "  base: '${2:flex items-center text-fg bg-surface border border-border-subtle rounded-control}',",
      "  variants: {",
      "    variant: {",
      "      default: 'bg-control text-fg hover:bg-control-hover active:bg-control-pressed',",
      "      subtle: 'bg-transparent text-fg-secondary hover:bg-fill-hover hover:text-fg',",
      "      accent: 'bg-accent text-on-accent hover:bg-accent-hover active:bg-accent-active',",
      "      danger: 'bg-danger-subtle text-danger-fg border-danger-border hover:bg-danger hover:text-on-danger',",
      "    },",
      "    size: {",
      "      sm: 'h-control-sm px-2 text-xs',",
      "      md: 'h-control-md px-3 text-base',",
      "      lg: 'h-control-lg px-4 text-md',",
      "    },",
      "  },",
      "  defaultVariants: {",
      "    variant: 'default',",
      "    size: 'md',",
      "  },",
      "});",
      "",
      "export type ${1/(.*)/${1:/capitalize}/}VariantProps = VariantProps<typeof ${1:component}Variants>;"
    ],
    "description": "Create a tailwind-variants recipe with GENSLATE Nord tokens",
    "scope": "typescript,typescriptreact"
  },
  "Tailwind Variants Multi-Slot Recipe": {
    "prefix": "gstv-slots",
    "body": [
      "import { tv, type VariantProps } from 'tailwind-variants';",
      "",
      "export const ${1:component}Variants = tv({",
      "  slots: {",
      "    root: '${2:relative flex flex-col w-full bg-surface border border-border-subtle rounded-card}',",
      "    header: '${3:flex items-center justify-between px-3 py-2 border-b border-border-subtle}',",
      "    content: '${4:p-3 text-fg text-base}',",
      "    footer: '${5:flex items-center justify-end gap-2 px-3 py-2 border-t border-border-subtle bg-surface-raised}',",
      "  },",
      "  variants: {",
      "    density: {",
      "      compact: {",
      "        header: 'py-1 px-2',",
      "        content: 'p-2 text-sm',",
      "        footer: 'py-1 px-2',",
      "      },",
      "      normal: {",
      "        header: 'py-2 px-3',",
      "        content: 'p-3 text-base',",
      "        footer: 'py-2 px-3',",
      "      },",
      "    },",
      "  },",
      "  defaultVariants: {",
      "    density: 'normal',",
      "  },",
      "});",
      "",
      "export type ${1/(.*)/${1:/capitalize}/}VariantProps = VariantProps<typeof ${1:component}Variants>;"
    ],
    "description": "Create a multi-slot tailwind-variants recipe for compound components",
    "scope": "typescript,typescriptreact"
  }
}
