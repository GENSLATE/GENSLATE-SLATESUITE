      "#[tauri::command]",
      "#[tracing::instrument(skip_all)]",
      "pub async fn ${1:command_name}(",
      "    ${2:app_handle}: tauri::AppHandle,",
      ") -> Result<${3:()}, String> {",
      "    ${0}",
      "    Ok(())",
      "}"
    ],
    "description": "Scaffold a GENSLATE Tauri IPC command with tracing and Result",
    "scope": "rust"
  },
  "Rust Test Module": {
    "prefix": "gstestmod",
