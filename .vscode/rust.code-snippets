    "description": "Scaffold a Rust unit test module",
    "scope": "rust"
  },
  "Rust Error Enum": {
    "prefix": "gserror",
    "body": [
      "#[derive(Debug, thiserror::Error)]",
      "pub enum ${1:Error} {",
      "    #[error(\"${2:IO error: {0}}\")]",
      "    ${3:Io}(#[from] std::io::Error),",
      "    #[error(\"${4:Internal error: {0}}\")]",
      "    ${5:Internal}(String),",
      "}"
    ],
    "description": "Scaffold a thiserror enum for typed Rust errors",
    "scope": "rust"
  }
