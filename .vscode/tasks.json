{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: example app",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": "build",
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "example: vite dev server",
      "detail": "Frontend only (used by the Rust debug launch config)",
      "type": "shell",
      "command": "bun x moon run example:web-dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activesBegin": ".",
          "beginsPattern": "VITE|vite",
          "endsPattern": "Local:|ready in"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "silent" }
    },
    {
      "label": "check",
      "type": "shell",
      "command": "bun run check",
      "group": { "kind": "test", "isDefault": false },
      "problemMatcher": ["$tsc", "$rustc"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "bun run test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "format",
      "type": "shell",
      "command": "bun run format",
      "problemMatcher": []
    },
    {
      "label": "tokens",
      "type": "shell",
      "command": "bun run tokens",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "bun run build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc", "$rustc"]
    },
    {
      "label": "package",
      "type": "shell",
      "command": "bun run package",
      "problemMatcher": ["$rustc"]
    }
  ]
}
