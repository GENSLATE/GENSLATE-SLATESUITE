{
  "name": "genslate",
  "version": "0.1.0",
  "private": true,
  "description": "GENSLATE — a moon + bun monorepo of Tauri desktop apps with a shared Nord design system.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": {
    "packages": ["desktop/*", "packages/*", "webapp/*"],
    "catalog": {
      "@babel/core": "8.0.6",
      "@base-ui/react": "1.8.0",
      "@biomejs/biome": "2.5.14",
      "@commitlint/cli": "21.2.3",
      "@commitlint/config-conventional": "21.2.3",
      "@fontsource-variable/inter": "5.3.0",
      "@fontsource-variable/jetbrains-mono": "5.3.0",
      "@happy-dom/global-registrator": "20.14.5",
      "@moonrepo/cli": "2.5.5",
      "@rolldown/plugin-babel": "0.2.4",
      "@tailwindcss/vite": "4.3.3",
      "@tauri-apps/api": "2.11.1",
      "@tauri-apps/cli": "2.11.5",
      "@tauri-apps/plugin-opener": "2.5.5",
      "@tauri-apps/plugin-os": "2.3.2",
      "@testing-library/dom": "10.4.2",
      "@testing-library/jest-dom": "7.0.1",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.7",
      "@types/bun": "1.4.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.1",
      "@vscode/codicons": "0.0.46-24",
      "babel-plugin-react-compiler": "1.0.0",
      "cspell": "10.3.4",
      "knip": "6.38.0",
      "lefthook": "2.1.14",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "tailwind-merge": "3.7.0",
      "tailwind-variants": "3.3.1",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.3.1"
    }
  },
  "scripts": {
    "setup": "bun scripts/bun-commands/setup.ts",
    "dev": "bun scripts/bun-commands/dev.ts",
    "build": "bun scripts/bun-commands/build.ts",
    "package": "bun scripts/bun-commands/package.ts",
    "test": "bun scripts/bun-commands/test.ts",
    "check": "bun scripts/bun-commands/check.ts",
    "format": "bun scripts/bun-commands/format.ts",
    "tokens": "bun scripts/bun-commands/tokens.ts",
    "version": "bun scripts/bun-commands/version.ts",
    "new-app": "bun scripts/bun-commands/new-app.ts",
    "clean": "bun scripts/bun-commands/clean.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@genslate/config-typescript": "workspace:*",
    "@moonrepo/cli": "catalog:",
    "@types/bun": "catalog:",
    "cspell": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "typescript": "catalog:"
  },
  "trustedDependencies": ["@moonrepo/cli", "lefthook"]
}
