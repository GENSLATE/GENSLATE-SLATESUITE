# ─── GENSLATE INTERNAL CODE/DATA ──────────────────────────────────────
.genslate/*

# ─── Dependencies ─────────────────────────────────────────────────────
node_modules/

# ─── Build output ─────────────────────────────────────────────────────
dist/
target/
coverage/
*.tsbuildinfo
desktop/*/src-tauri/gen/schemas/
desktop/*/src-tauri/permissions/autogenerated/

# ─── Packaged releases (keep the folder) ──────────────────────────────
release/*
!release/.gitkeep

# ─── moon ─────────────────────────────────────────────────────────────
.config/moon/cache/
.config/moon/docker/

# ─── Secrets & environment ────────────────────────────────────────────
.env
.env.*
!.env.example
**/credentials.toml
*.pem
*.key

# ─── Claude Code (personal / runtime) ─────────────────────────────────
.claude/settings.local.json
.claude/logs/*
!.claude/logs/.gitkeep
CLAUDE.local.md

# ─── App runtime logs (keep the folders) ──────────────────────────────
other/logs/**/*.log
other/logs/**/*.log.*

# ─── App runtime data (dev) — regenerated, never committed ────────────
other/cache/*
!other/cache/.gitkeep
other/databases/**/*
!other/databases/**/
!other/databases/**/.gitkeep

# ─── Launcher dev installDir: keep the template, ignore what you drop in
desktop/launcher/installDir/programs/**/*
!desktop/launcher/installDir/programs/**/
!desktop/launcher/installDir/programs/**/.gitkeep
desktop/launcher/installDir/storage/**/*
!desktop/launcher/installDir/storage/**/
!desktop/launcher/installDir/storage/**/.gitkeep

# ─── OS / editor noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
