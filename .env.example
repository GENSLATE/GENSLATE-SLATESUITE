# Copy to `.env` for local overrides. `.env*` files are git-ignored (except this one).
# Never put secrets in the frontend — anything prefixed VITE_ or TAURI_ENV_ is bundled into the app.

# Log level for Rust (tracing EnvFilter syntax).
RUST_LOG=info

# Set to 1 to run desktop apps in portable mode (config/logs next to the executable).
GENSLATE_PORTABLE=0
